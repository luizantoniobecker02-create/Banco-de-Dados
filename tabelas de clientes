CREATE DATABASE ERP_Treino;
DROP TABLE dbo.Estoques
USE ERP_Treino;

CREATE TABLE Clientes (
	ClienteId INT IDENTITY(1,1) NOT NULL,
	Codigo VARCHAR(20) NOT NULL,
	Nome NVARCHAR(200) NOT NULL,
	Documento VARCHAR(20) NULL,
	Email NVARCHAR (254) NULL,
	Telefone NVARCHAR(30) NULL,
	Ativo BIT NOT NULL DEFAULT 1,
	CriadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
	AtualizadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
	LimiteCompra DECIMAL(18, 2) NULL,

	--Restrições de integridade (chaves e validações)
	CONSTRAINT PK_Clientes PRIMARY KEY (ClienteId),
	CONSTRAINT UQ_Clientes_Codigos UNIQUE (Codigo),
	CONSTRAINT CK_Clientes_Email CHECK (Email IS NULL OR Email LIKE '%@%.%')
);

CREATE TABLE Fornecedores (
	FornecedorId INT IDENTITY(1,1) NOT NULL,
	Codigo VARCHAR(20) NOT NULL,
	RazaoSocial NVARCHAR(200) NOT NULL,
	Documento VARCHAR(20) NULL,
	Email NVARCHAR (254) NULL,
	Telefone NVARCHAR(30) NULL,
	Ativo BIT NOT NULL DEFAULT 1,
	CriadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
	AtualizadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),

	--Restrições de integridades
	CONSTRAINT PK_Fornecedores PRIMARY KEY (FornecedorId),
	CONSTRAINT UQ_Fornecedores_Codigos UNIQUE (Codigo),
	CONSTRAINT CK_Fornecedores_Email CHECK (Email IS NULL OR Email LIKE '%@%.%')
);

CREATE TABLE Produtos (
	ProdutoId INT IDENTITY(1,1) NOT NULL,
	SKU VARCHAR(40) NOT NULL,
	Nome NVARCHAR(200) NOT NULL,
	Unidade VARCHAR(10) NOT NULL DEFAULT 'UN',
	PrecoVenda DECIMAL (18, 2) NOT NULL DEFAULT 0,
	CustoPadrao DECIMAL (18, 2) NOT NULL DEFAULT 0,
	Ativo BIT NOT NULL DEFAULT 1,
	CriadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
	AtualizadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),

	--Restrições de integridades
	CONSTRAINT PK_Produtos PRIMARY KEY (ProdutoId),
	CONSTRAINT UQ_Produtos_SKU UNIQUE (SKU),
	CONSTRAINT CK_Produtos_Precos CHECK (PrecoVenda >= 0 AND CustoPadrao >= 0)
);

CREATE TABLE Produtos (
	ProdutoId INT IDENTITY(1,1) NOT NULL,
	SKU VARCHAR(40) NOT NULL,
	Nome NVARCHAR(200) NOT NULL,
	Unidade VARCHAR(10) NOT NULL DEFAULT 'UN',
	PrecoVenda DECIMAL (18, 2) NOT NULL DEFAULT 0,
	CustoPadrao DECIMAL (18, 2) NOT NULL DEFAULT 0,
	Ativo BIT NOT NULL DEFAULT 1,
	CriadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
	AtualizadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),

	--Restrições de integridades
	CONSTRAINT PK_Produtos PRIMARY KEY (ProdutoId),
	CONSTRAINT UQ_Produtos_SKU UNIQUE (SKU),
	CONSTRAINT CK_Produtos_Precos CHECK (PrecoVenda >= 0 AND CustoPadrao >= 0)
);

CREATE TABLE dbo.Armazens (
    ArmazemId INT IDENTITY(1,1) NOT NULL,
    Codigo VARCHAR(20) NOT NULL,
    Nome NVARCHAR(120) NOT NULL,
    Ativo BIT NOT NULL,
    CriadoEm DATETIME2(0) NOT NULL,
    AtualizadoEm DATETIME2(0) NOT NULL,
    
    CONSTRAINT PK_Armazens PRIMARY KEY CLUSTERED (ArmazemId),
	CONSTRAINT UQ_Armazens_Codigo UNIQUE (Codigo)
);

CREATE TABLE dbo.Estoques (
    EstoqueId INT IDENTITY (1,1) NOT NULL,
    ProdutoId INT NOT NULL,
    ArmazemId INT NOT NULL,
    Quantidade DECIMAL(18,3) NOT NULL DEFAULT 0,
    QuantidadeMin DECIMAL(18,3) NOT NULL DEFAULT 0,
    AtualizadoEm DATETIME2(0) NOT NULL DEFAULT sysutcdatetime(),
    
    -- Definição da Chave Primária
    CONSTRAINT PK_Estoques PRIMARY KEY (EstoqueId),
	CONSTRAINT UQ_Estoques_Produto_Armazem UNIQUE (ProdutoId,ArmazemId),
	CONSTRAINT FK_Estoques_Armazens FOREIGN KEY (ArmazemId) REFERENCES Armazens (ArmazemId),
	CONSTRAINT FK_Estoques_Produtos FOREIGN KEY (ProdutoId) REFERENCES Produtos (ProdutoId),
	CONSTRAINT CK_Estoques_QTD CHECK (Quantidade >=0 AND QuantidadeMin >=0)
);

CREATE TABLE dbo.PedidosVenda (
    PedidoVendaId INT NOT NULL,
    Numero VARCHAR(30) NOT NULL,
    ClienteId INT NOT NULL,
    Status VARCHAR(12) NOT NULL,
    DataPedido DATE NOT NULL,
    TotalProdutos DECIMAL(18, 2) NOT NULL,
    TotalPedido AS (TotalProdutos), 
    CriadoEm DATETIME2(0) NOT NULL,
    AtualizadoEm DATETIME2(0) NOT NULL,

    CONSTRAINT PK_PedidosVenda PRIMARY KEY (PedidoVendaId),
    CONSTRAINT UQ_PedidosVenda_Numero UNIQUE (Numero),
	CONSTRAINT FK_PV_Clientes FOREIGN KEY (ClienteId) REFERENCES Clientes (ClienteId),
	CONSTRAINT CK_PV_Status CHECK (Status IN ('CANCELADO','FATURADO','ABERTO')),
	CONSTRAINT CK_PV_Total CHECK (TotalProdutos >=0)
);




